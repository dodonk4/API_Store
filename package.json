{
  "name": "api-rest-store",
  "version": "1.0.0",
  "description": "API REST para gestionar productos, usuarios y órdenes en una tienda",
  "main": "src/server.js",
  "type": "module",
  "scripts": {
    "dev": "dotenv -e .env.development -- nodemon --exec ts-node src/server.ts",
    "test": "dotenv -e .env.test -- node --experimental-vm-modules node_modules/jest/bin/jest.js --runInBand",
    "start": "dotenv -e .env.production -- ts-node src/server.ts",
    "seed:dev": "dotenv -e .env.development -- tsx prisma/seed.ts",
    "seed:test": "dotenv -e .env.test -- tsx prisma/seed.ts",
    "migrate:dev": "dotenv -e .env.development -- prisma migrate dev",
    "migrate:test": "dotenv -e .env.test -- prisma migrate dev",
    "migrate:prod": "dotenv -e .env.production -- prisma migrate deploy",
    "reset:test": "dotenv -e .env.test -- npx prisma migrate reset"
  },
  "dependencies": {
    "@prisma/client": "^7.8.0",
    "bcryptjs": "^3.0.3",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.6",
    "express": "^5.2.1",
    "jsonwebtoken": "^9.0.3",
    "sqlite3": "^6.0.1",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@babel/core": "^7.26.0",
    "@babel/preset-env": "^7.26.0",
    "@babel/preset-typescript": "^7.29.7",
    "@prisma/adapter-pg": "^7.8.0",
    "@types/cookie-parser": "^1.4.10",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/jest": "^30.0.0",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^25.9.3",
    "@types/pg": "^8.20.0",
    "@types/sqlite3": "^3.1.11",
    "@types/supertest": "^7.2.0",
    "babel-jest": "^30.4.1",
    "cookiejar": "^2.1.4",
    "cross-env": "^10.1.0",
    "dotenv": "^17.4.2",
    "dotenv-cli": "^11.0.0",
    "jest": "^30.4.2",
    "nodemon": "^3.1.14",
    "pg": "^8.21.0",
    "prisma": "^7.8.0",
    "supertest": "^7.2.2",
    "ts-jest": "^29.4.11",
    "ts-node": "^10.9.2",
    "tsc-alias": "^1.8.17",
    "tsconfig-paths": "^4.2.0",
    "tsx": "^4.22.4",
    "typescript": "^6.0.3"
  },
  "keywords": [
    "api",
    "rest",
    "store",
    "productos",
    "usuarios",
    "ordenes"
  ],
  "author": "",
  "license": "ISC"
}
