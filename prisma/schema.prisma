generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model ordenes {
  id               Int                 @id @default(autoincrement())
  usuarioId       Int?
  fecha          DateTime? @default(now())
  estado         String?   @db.VarChar(20)
  usuarios         usuarios?           @relation(fields: [usuarioId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  createdAt    DateTime @default(now())
  ordenesProductos ordenes_productos[]
}

model usuarios {
  id      Int       @id @default(autoincrement())
  nombre  String?   @db.VarChar(100)
  email   String?   @db.VarChar(30)@unique
  password String 
  refreshToken String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  ordenes ordenes[]
}

model productos {
  id               Int                 @id @default(autoincrement())
  nombre           String?             @db.VarChar(100)
  descripcion      String?             @db.VarChar(200)
  categoria      String?             @db.VarChar(200)
  stock            Int                 @default(0)
  precio           Int                 @default(0)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  ordenesProductos ordenes_productos[]
}

model ordenes_productos {
  id             Int       @id @default(autoincrement())
  ordenId        Int
  orden          ordenes   @relation(fields: [ordenId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  productId      Int
  productos      productos @relation(fields: [productId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  precioUnitario Int      @default(0)
  cantidad Int @default(0)
}
