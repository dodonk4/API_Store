generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Rols{
  USER
  ADMIN
}

enum States{
  CART
  PENDING_PAYMENT
  PAID
  CANCELED
}

model orders {
  id               Int                 @id @default(autoincrement())
  userId       Int
  date          DateTime @default(now())
  state         States   @default(CART)
  users         users           @relation(fields: [userId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  createdAt    DateTime @default(now())
  ordersProducts orders_products[]
}

model users {
  id      Int       @id @default(autoincrement())
  username  String   @db.VarChar(100)
  email   String   @db.VarChar(30)@unique
  rol Rols @default(USER)
  password String 
  refreshToken String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  orders orders[]
}

model products {
  id               Int                 @id @default(autoincrement())
  name           String             @db.VarChar(100)
  description      String?             @db.VarChar(200)
  category      String             @db.VarChar(200)
  stock            Int                 @default(0)
  price           Decimal                 @default(0)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  ordersProducts orders_products[]
}

model orders_products {
  id             Int       @id @default(autoincrement())
  orderId        Int
  order          orders   @relation(fields: [orderId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  productId      Int
  products      products @relation(fields: [productId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  unitPrice Decimal      @default(0)
  quantity Int @default(0)
}
