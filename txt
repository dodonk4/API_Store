##Guía para instalar 

git clone https://github.com/dodonk4/API_Store.git //Clona
npm i
docker compose up -d
npx prisma generate

//Crear archivos .env

.env.development: {
  DATABASE_URL="postgresql://postgres:postgres@localhost:5432/api_store_dev"
  AUTH_SECRET="your_jwt_access_token_secret" 
  AUTH_SECRET_EXPIRES_IN="15m"
  AUTH_REFRESH_SECRET="your_jwt_refresh_token_secret"
  AUTH_REFRESH_SECRET_EXPIRES_IN="24h"
}
.env.test: {
  DATABASE_URL="postgresql://postgres:postgres@localhost:5432/api_store_test"
  AUTH_SECRET="your_jwt_access_token_secret" 
  AUTH_SECRET_EXPIRES_IN="15m"
  AUTH_REFRESH_SECRET="your_jwt_refresh_token_secret"
  AUTH_REFRESH_SECRET_EXPIRES_IN="24h"
}

npm run migrate:dev //BD de producción
npm run seed:dev //Datos de prueba para la BD de producción

//Testing
npm run migrate:test //BD de test
npm run seed:test //Datos de prueba para la BD de test
